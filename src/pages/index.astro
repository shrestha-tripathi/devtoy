---
import Layout from "../layouts/Layout.astro";
import AppShell from "../components/AppShell.astro";
import Footer from "../components/Footer.astro";
import { toolPages } from "../data/tools";
import { site, lastUpdatedLabel } from "../site.config";
import { homeTldr, homeFaqs as faqs, webAppLd } from "../data/geo";

const jsonLd = [
  webAppLd({ name: site.name, description: site.description, path: "/" }),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Layout path="/" jsonLd={jsonLd}>
  <AppShell mode="home">
    <section class="seo-content">
      <h1>{site.name}: offline developer tools in your browser</h1>
      <p class="tldr"><strong>TL;DR:</strong> {homeTldr}</p>
      <p>{site.description}</p>
      <p class="last-updated">Last updated {lastUpdatedLabel()}</p>
      <h2>Tools</h2>
      <ul>
        {toolPages.map((p) => <li><a href={`/${p.slug}/`}>{p.h1}</a> — {p.metaDescription}</li>)}
      </ul>
      <h2>FAQ</h2>
      {faqs.map((f) => (<Fragment><h3>{f.q}</h3><p>{f.a}</p></Fragment>))}
    </section>
    <Footer />
  </AppShell>
</Layout>
<script>
  import "../main.js";
</script>
