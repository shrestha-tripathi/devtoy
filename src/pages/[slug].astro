---
import Layout from "../layouts/Layout.astro";
import AppShell from "../components/AppShell.astro";
import Footer from "../components/Footer.astro";
import { toolPages, bySlug } from "../data/tools";
import { absoluteUrl, lastUpdatedLabel } from "../site.config";
import { webAppLd } from "../data/geo";

export function getStaticPaths() {
  return toolPages.map((p) => ({ params: { slug: p.slug } }));
}
const page = bySlug(Astro.params.slug!)!;
const path = `/${page.slug}/`;
const related = page.related.map((s) => bySlug(s)).filter(Boolean);

const tldr = `The ${page.h1} is free, needs no sign-up and runs entirely in your browser. ${page.metaDescription} ${page.tips?.[0] ?? ""}`.trim();
const jsonLd = [
  webAppLd({ name: page.h1, description: page.metaDescription, path }),
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: `How to use the ${page.h1}`,
    step: page.steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, text: s })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: page.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: page.h1, item: absoluteUrl(path) },
    ],
  },
];
---
<Layout title={page.title} description={page.metaDescription} path={path} jsonLd={jsonLd}>
  <AppShell mode="tool" active={page.tool} h1={page.h1}>
    <div data-tool-page={page.tool} data-preset={page.preset} hidden></div>
    <article class="seo-content">
      <p class="tldr"><strong>TL;DR:</strong> {tldr}</p>
      <p>{page.intro}</p>
      <p class="last-updated">Last updated {lastUpdatedLabel()}</p>
      <h2>How to use the {page.h1}</h2>
      <ol>{page.steps.map((s) => <li>{s}</li>)}</ol>
      {page.tips && page.tips.length > 0 && (
        <Fragment>
          <h2>Tips</h2>
          <ul>{page.tips.map((t) => <li>{t}</li>)}</ul>
        </Fragment>
      )}
      <h2>Frequently asked questions</h2>
      {page.faqs.map((f) => (<Fragment><h3>{f.q}</h3><p>{f.a}</p></Fragment>))}
      <h2>Related tools</h2>
      <ul class="related-links">
        {related.map((r) => <li><a href={`/${r!.slug}/`}>{r!.h1}</a></li>)}
        <li><a href="/">All-in-one Smart Paste</a></li>
      </ul>
    </article>
    <Footer />
  </AppShell>
</Layout>
<script>
  import "../client/toolPage.js";
</script>
